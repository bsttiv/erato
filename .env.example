# Erato — Environment Variables Example
# All credentials, connection strings, and keys must be supplied via environment variables.
# Do not commit real secret values to version control (AGENTS.md rule 4).

# ==============================================================================
# Database (MongoDB)
# ==============================================================================
# Full MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas SRV)
MONGODB_URI=

# Database name in MongoDB
MONGODB_DB=

# Optional local root credentials for docker-compose local mongo service
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Secret key used to sign HS256 JWT access tokens (minimum 32 random bytes recommended)
JWT_SECRET=

# Access token time-to-live in minutes (stateless JWT, default: 15)
ACCESS_TOKEN_TTL_MINUTES=

# Refresh token time-to-live in days (rotating opaque token in HttpOnly cookie, default: 30)
REFRESH_TOKEN_TTL_DAYS=

# Invite token time-to-live in days (single-use token, default: 14)
INVITE_TOKEN_TTL_DAYS=

# ==============================================================================
# Cloudinary Media Storage
# ==============================================================================
# Cloudinary cloud name for direct signed demo audio uploads
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key
CLOUDINARY_API_KEY=

# Cloudinary API secret for signing upload requests and verifying responses
CLOUDINARY_API_SECRET=

# Folder prefix for uploaded audio assets (e.g., "erato" or "erato/dev")
CLOUDINARY_FOLDER_PREFIX=

# ==============================================================================
# Application URL
# ==============================================================================
# Base URL for the frontend application (used for generating invitation links)
APP_BASE_URL=

# Secret token guarding cron endpoints (e.g., /api/cron/orphan-sweep)
CRON_SECRET=
